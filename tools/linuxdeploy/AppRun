#!/bin/sh
set -eu

APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export APPDIR

# Do not inherit plugin or loader paths from another Qt application/launcher.
unset QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH QML_IMPORT_PATH QML2_IMPORT_PATH
unset LD_LIBRARY_PATH LD_PRELOAD
QT_PLUGIN_PATH="$APPDIR/usr/plugins"
export QT_PLUGIN_PATH

# Install shipped defaults beside the AppImage, without replacing user data.
# No ROM, imported assets, settings or save from the build machine is bundled.
if [ -n "${APPIMAGE:-}" ]; then
    DataDir=$(dirname -- "$APPIMAGE")
    # An AppImage ships as one file: create its companion saves folder before
    # the game starts, so users can import a save before importing their ROM.
    mkdir -p -- "$DataDir/saves"
else
    DataDir=$APPDIR
    APPIMAGE="$APPDIR/AppRun"
    export APPIMAGE
fi
# Migrate older default-on Level Cap files before populating shipped defaults.
# The marker prevents later launches from undoing a user's manual re-enable.
OptionalRoot="$DataDir/Unapplied Mods"
OptionalLevelCap="$OptionalRoot/level_cap"
LevelCapTransition="$OptionalRoot/.level-cap-v251-migrated"
if [ ! -e "$LevelCapTransition" ]; then
    mkdir -p -- "$OptionalLevelCap"
    for File in \
        "$DataDir/mods/level_cap/level_cap.lua" \
        "$DataDir/mods/level_cap/level_caps.json" \
        "$DataDir/mods/level_cap.lua" \
        "$DataDir/mods/level_caps.json" \
        "$DataDir/mods/level_cap/level_cap.so" \
        "$DataDir/mods/level_cap.so"; do
        [ -f "$File" ] || continue
        Name=$(basename -- "$File")
        Target="$OptionalLevelCap/$Name"
        if [ -e "$Target" ]; then
            if cmp -s -- "$File" "$Target"; then
                rm -f -- "$File"
                continue
            fi
            Target="$OptionalLevelCap/previous-active-$Name"
            while [ -e "$Target" ]; do
                Target="$Target.bak"
            done
        fi
        mv -- "$File" "$Target"
    done
    rmdir -- "$DataDir/mods/level_cap" 2>/dev/null || true
    : > "$LevelCapTransition"
fi

Defaults="$APPDIR/usr/share/pokeplatinum/defaults"
if [ -d "$Defaults" ]; then
    (cd "$Defaults" && find . -type f) | while IFS= read -r File; do
        if [ ! -e "$DataDir/$File" ]; then
            mkdir -p -- "$(dirname -- "$DataDir/$File")"
            cp -n -- "$Defaults/$File" "$DataDir/$File"
        fi
    done
fi

# Use the matching bundled glibc and loader as well as Qt/SDL. This avoids
# imposing the build distribution's GLIBC/GLIBCXX versions on the recipient.
# --library-path applies only to the game, not to external desktop programs.
exec "$APPDIR/usr/lib/ld-linux-x86-64.so.2" \
    --library-path "$APPDIR/usr/lib" "$APPDIR/usr/bin/app" "$@"
