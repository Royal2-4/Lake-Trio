 BOOL SIM_GetScreensSwapped(void) {
+  if (s_SIM_config.screenLayout == SIM_CONFIG_SCREEN_LAYOUT_SINGLE_SMART) {
+    const int manual = sSmartScreenManual.load();
+    // One Screen S always defaults to the primary display. Only gameplay
+    // contexts or an explicit transient override expose the touchscreen.
+    return manual >= 0 ? manual != 0 : sSmartScreenContexts.load() != 0;
+  }
   int swapped = sScreensSwapped.load();
@@ -836,1 +847,30 @@ void SIM_SetScreensSwapped(BOOL swapped) {
+void SIM_SmartScreen_SetContext(u32 context, BOOL active) {
+  const unsigned int known = SIM_SMART_SCREEN_BATTLE_COMMANDS |
+                             SIM_SMART_SCREEN_BATTLE_MENU |
+                             SIM_SMART_SCREEN_NAMING |
+                             SIM_SMART_SCREEN_BATTLE_PARTY;
+  context &= known;
+  if (!context) return;
+  const unsigned int previous = active
+      ? sSmartScreenContexts.fetch_or(context)
+      : sSmartScreenContexts.fetch_and(~context);
+  const unsigned int next = active ? previous | context : previous & ~context;
+  // A manual choice survives intermediate panels. Restore automatic control
+  // only on entering or fully leaving an interaction session.
+  if ((previous == 0) != (next == 0)) sSmartScreenManual.store(-1);
+}
+
+void SIM_SmartScreen_SetManual(BOOL touchscreenVisible) {
+  sSmartScreenManual.store(touchscreenVisible != 0);
+}
+
+void SIM_SmartScreen_ToggleManual(void) {
+  if (s_SIM_config.screenLayout != SIM_CONFIG_SCREEN_LAYOUT_SINGLE_SMART) return;
+  sSmartScreenManual.store(!SIM_GetScreensSwapped());
+}
+
+void SIM_SmartScreen_ClearManual(void) {
+  sSmartScreenManual.store(-1);
+}
