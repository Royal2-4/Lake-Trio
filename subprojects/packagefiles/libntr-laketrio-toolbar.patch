         return;
@@ -309,3 +313,13 @@ bool SIM_GUI_ProcessEvent(SDL_Event *aEvent)
     if (!SIM_GUI_State && !IsMenuBarVisible()) {
-        return false;
+        if (!SIM_GUI_Prj_Toolbar) return false;
+        // The small overlay should handle mouse clicks, not steal gameplay keys.
+        const bool mouseEvent = aEvent->type == SDL_MOUSEMOTION
+            || aEvent->type == SDL_MOUSEBUTTONDOWN
+            || aEvent->type == SDL_MOUSEBUTTONUP
+            || aEvent->type == SDL_MOUSEWHEEL;
+        if (!mouseEvent) return false;
+        ImGui_ImplSDL2_ProcessEvent(aEvent);
+        const bool click = aEvent->type == SDL_MOUSEBUTTONDOWN
+            || aEvent->type == SDL_MOUSEBUTTONUP;
