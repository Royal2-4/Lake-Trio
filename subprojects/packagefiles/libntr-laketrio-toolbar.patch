diff --git a/libraries/sim/src/gui/gui.c b/libraries/sim/src/gui/gui.c
index 6990837..2d82445 100644
--- a/libraries/sim/src/gui/gui.c
+++ b/libraries/sim/src/gui/gui.c
@@ -138,1 +138,4 @@ extern int PlatformMenu_Update(int) __attribute__((weak));
+// The application supplies the visible toolbar without owning the SDL renderer.
+void SIM_GUI_Prj_Toolbar(int canImport) __attribute__((weak));
+
 static void DrawSimulatorMenuBar(void)
@@ -146,2 +149,3 @@ static void DrawSimulatorMenuBar(void)
         if (action == 2) s_showWindowPad = true;
