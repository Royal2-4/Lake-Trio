 {
     ImGui_ImplSDL2_Data* bd = ImGui_ImplSDL2_GetBackendData();
     ImGuiIO& io = ImGui::GetIO();
+    // Lake-Trio hot-plug fallback: controller events may be missed while the
+    // dashboard is hidden. Poll for a changed device count or stale handles
+    // before reading navigation buttons. An unplug/replug may keep the same
+    // device count, so checking only SDL_NumJoysticks() is not enough.
+    if (bd->GamepadMode != ImGui_ImplSDL2_GamepadMode_Manual)
+    {
+        const int count = SDL_NumJoysticks();
+        if (count >= 0 && count != bd->LastJoystickCount)
+            bd->WantUpdateGamepadsList = true;
+        for (SDL_GameController* gamepad : bd->Gamepads)
+            if (!SDL_GameControllerGetAttached(gamepad))
+            {
+                bd->WantUpdateGamepadsList = true;
+                break;
+            }
+    }
     // Update list of controller(s) to use
     if (bd->WantUpdateGamepadsList && bd->GamepadMode != ImGui_ImplSDL2_GamepadMode_Manual)
     {
         ImGui_ImplSDL2_CloseGamepads();
         int joystick_count = SDL_NumJoysticks();
