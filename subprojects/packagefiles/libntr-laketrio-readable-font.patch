     font->SizePixels = 13.0f * scale * density;
     ImFontAtlas_AddFontDefault(io->Fonts, font);
     ImFontConfig_destroy(font);
+    s_lakeTrioDashboardFont = LoadLakeTrioDashboardFont(io->Fonts, 17.0f * scale * density);
     io->FontGlobalScale = 1.0f / density;
     ImGui_ImplOpenGL3_CreateFontsTexture();
 }
