+// Keep the PC save in the game's saves/ directory. No legacy save migration.
+SDK_INLINE FILE *CARDi_OpenSaveFile(const char *mode)
+{
+#ifdef _WIN32
+    (void)_mkdir("saves");
+#else
+    (void)mkdir("saves", 0777);
+#endif
+    return fopen("saves/save.bin", mode);
+}
