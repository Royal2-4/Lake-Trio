+// Lake-Trio keeps gameplay button assignments in game.ini as *raw* SDL
+// joystick button indices. ImGui normally assumes SDL_CONTROLLER_BUTTON_A/B,
+// which ignores a user-selected Nintendo-style face-button layout.
+extern "C" void LakeTrio_GUI_GetNavButtons(int *confirm, int *back);
+static void ImGui_ImplSDL2_LakeTrio_UpdateBoundFaceButtons(ImGui_ImplSDL2_Data* bd, ImGuiIO& io)
+{
+    int boundA = -1, boundB = -1;
+    LakeTrio_GUI_GetNavButtons(&boundA, &boundB);
+    bool confirm = false, back = false;
+    for (SDL_GameController* controller : bd->Gamepads)
+    {
+        SDL_Joystick* joystick = SDL_GameControllerGetJoystick(controller);
+        const int buttonCount = joystick ? SDL_JoystickNumButtons(joystick) : 0;
+        const SDL_GameControllerButtonBind defaultA =
+            SDL_GameControllerGetBindForButton(controller, SDL_CONTROLLER_BUTTON_A);
+        const SDL_GameControllerButtonBind defaultB =
+            SDL_GameControllerGetBindForButton(controller, SDL_CONTROLLER_BUTTON_B);
+        const int rawA = defaultA.bindType == SDL_CONTROLLER_BINDTYPE_BUTTON ? defaultA.value.button : -1;
+        const int rawB = defaultB.bindType == SDL_CONTROLLER_BINDTYPE_BUTTON ? defaultB.value.button : -1;
+        const bool assignedA = boundA >= 0 && boundA < buttonCount;
+        const bool assignedB = boundB >= 0 && boundB < buttonCount;
+        int confirmButton = assignedA ? boundA : rawA;
+        int backButton = assignedB ? boundB : rawB;
+        // The binding editor clears an existing assignment before a swap is
+        // complete. Never route the claimed physical button to both actions.
+        if (confirmButton >= 0 && confirmButton == backButton)
+        {
+            if (assignedA && !assignedB)
+                backButton = rawA != confirmButton ? rawA : -1;
+            else if (assignedB && !assignedA)
+                confirmButton = rawB != backButton ? rawB : -1;
+            else
+                backButton = -1;
+        }
+        confirm |= confirmButton >= 0 && confirmButton < buttonCount
+            ? SDL_JoystickGetButton(joystick, confirmButton) != 0
+            : (!assignedA && !assignedB && rawA < 0 && SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_A) != 0);
+        back |= backButton >= 0 && backButton < buttonCount
+            ? SDL_JoystickGetButton(joystick, backButton) != 0
+            : (!assignedA && !assignedB && rawB < 0 && SDL_GameControllerGetButton(controller, SDL_CONTROLLER_BUTTON_B) != 0);
+    }
+    io.AddKeyEvent(ImGuiKey_GamepadFaceDown, confirm);  // Confirm (game A)
+    io.AddKeyEvent(ImGuiKey_GamepadFaceRight, back);    // Cancel (game B)
+}
 static void ImGui_ImplSDL2_UpdateGamepadButton(ImGui_ImplSDL2_Data* bd, ImGuiIO& io, ImGuiKey key, SDL_GameControllerButton button_no)
 {
     bool merged_value = false;
@@ -802,11 +802,10 @@
