@@ -2793,1 +2798,33 @@ static u64 JoystickShortcutMask(int key) {
+#ifndef SDK_BUILD_NX
+// Reject stick clicks from the *game* input path, but leave SDL events intact
+// for the overlay's L3+R3 and R3+LT shortcut handlers. SDL's controller map
+// is more reliable than saved raw button indices across SteamOS and Windows.
+static bool IsReservedStickClick(const SDL_JoyButtonEvent &event) {
+  for (int i = 0; i < SDL_NumJoysticks(); ++i) {
+    if (SDL_JoystickGetDeviceInstanceID(i) != event.which) continue;
+    if (SDL_IsGameController(i)) {
+      SDL_GameController *controller = SDL_GameControllerOpen(i);
+      if (controller != NULL) {
+        const SDL_GameControllerButtonBind left = SDL_GameControllerGetBindForButton(
+            controller, SDL_CONTROLLER_BUTTON_LEFTSTICK);
+        const SDL_GameControllerButtonBind right = SDL_GameControllerGetBindForButton(
+            controller, SDL_CONTROLLER_BUTTON_RIGHTSTICK);
+        SDL_GameControllerClose(controller);
+        const bool leftMapped = left.bindType == SDL_CONTROLLER_BINDTYPE_BUTTON;
+        const bool rightMapped = right.bindType == SDL_CONTROLLER_BINDTYPE_BUTTON;
+        // A mapped pad's unrelated raw buttons must not be discarded merely
+        // because their indices happen to match another pad's saved defaults.
+        if (leftMapped || rightMapped)
+          return (leftMapped && left.value.button == event.button) ||
+                 (rightMapped && right.value.button == event.button);
+      }
+    }
+    break;
+  }
+  // Generic joysticks may lack an SDL GameController mapping.
+  return event.button == s_SIM_config.padSettings.l3JoyKey ||
+         event.button == s_SIM_config.padSettings.r3JoyKey;
+}
+#endif
+
 static void HandleJoystickKeyDown(int key) {
@@ -3018,6 +3055,16 @@ void *SIM_Render(void *arg) {
       if (Event.type == SDL_JOYBUTTONDOWN) {
+#ifdef SDK_BUILD_NX
         HandleJoystickKeyDown(Event.jbutton.button);
+#else
+        if (!IsReservedStickClick(Event.jbutton))
+          HandleJoystickKeyDown(Event.jbutton.button);
+#endif
       }
       if (Event.type == SDL_JOYBUTTONUP) {
+#ifdef SDK_BUILD_NX
         HandleJoystickKeyUp(Event.jbutton.button);
+#else
+        if (!IsReservedStickClick(Event.jbutton))
+          HandleJoystickKeyUp(Event.jbutton.button);
+#endif
       }
