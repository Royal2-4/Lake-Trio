+// Enqueue the size change for the simulator/windowing thread. The resulting
+// window size is persisted only after applying the request.
+void SIM_RequestWindowResolution(u32 width, u32 height) {
+  if (width < 640 || height < 480 || width > 8192 || height > 4320) return;
+  sRequestedWindowSizeMode.store(0);
+  sRequestedWindowResolution.store((u64(width) << 32) | u64(height));
+}
+
 static void GetWindowDimensionsForMode(u32 mode, u32 *width, u32 *height) {
+  if (mode == 6 && s_SIM_config.customWindowWidth >= 640
+      && s_SIM_config.customWindowHeight >= 480) {
+    *width = s_SIM_config.customWindowWidth;
+    *height = s_SIM_config.customWindowHeight;
+    return;
+  }
+  if (mode == 6) mode = 2;
   *width = SIM_NDS_SCREEN_WIDTH * mode;
   *height = SIM_NDS_SCREEN_HEIGHT * mode;
 
